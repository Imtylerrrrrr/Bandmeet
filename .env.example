# ── Supabase (대시보드 → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# 서버 전용. 절대 클라이언트/깃에 노출 금지 (빌드매뉴얼 4장).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── DB 연결 (Supabase → Database → Connection string) ──
# 앱 런타임은 pooler(:6543, pgbouncer transaction), Drizzle 마이그레이션도 동일 URL 사용 가능.
# drizzle.config.ts 는 이 값을 .env.local 에서 읽습니다.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
