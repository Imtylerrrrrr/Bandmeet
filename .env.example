# ── Supabase (대시보드 → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# 서버 전용. 절대 클라이언트/깃에 노출 금지 (빌드매뉴얼 4장).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── DB 연결 (Supabase → Connect → Session pooler) ──
# Session pooler(:5432) 권장 — 런타임+마이그레이션 단일 URL, IPv4.
# (Direct 연결은 IPv6 전용이라 Vercel 등에서 실패 가능. Transaction pooler:6543 은 migrate 가 실패할 수 있음.)
# drizzle.config.ts 는 이 값을 .env.local 에서 읽습니다.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Vercel Cron 보호 (선택) ──
# 설정 시 /api/cron/close-votes 가 Bearer 로 보호됨. Vercel 환경변수에도 동일 값 등록.
# 로컬 dev 에선 비워두면 가드 비활성. 운영에선 반드시 임의 난수로 설정.
CRON_SECRET=
